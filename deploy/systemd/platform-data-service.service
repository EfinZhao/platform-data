[Unit]
Description=platform-data merged service — sensor loggers + dashboard API + frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_ME
Group=REPLACE_ME
WorkingDirectory=/opt/platform-data/service
ExecStart=/opt/platform-data/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

# On shutdown the ingest service stops its collectors and flushes every buffer,
# so up to a minute of data per sensor is written during stop. This must exceed
# main.INGEST_DRAIN_TIMEOUT_S (30s) or systemd SIGKILLs the process mid-flush
# and the data is lost -- which is exactly what used to happen.
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
