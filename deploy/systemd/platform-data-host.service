[Unit]
Description=platform-data Parquet browser (host.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_ME
Group=REPLACE_ME
WorkingDirectory=/opt/platform-data/logging
ExecStart=/opt/platform-data/.venv/bin/python3 host.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
